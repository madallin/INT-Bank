SERVER_URL=localhost
SERVER_PORT=8443
# SHA-256 of the server's TLS certificate (comma separated; add the next certificate's
# pin before rotating). Required for release builds: without it a release build refuses
# to connect and shows a setup error. Debug builds may leave it empty.
# openssl x509 -in server.crt -outform der | openssl dgst -sha256
CERT_SHA256_PINS=
